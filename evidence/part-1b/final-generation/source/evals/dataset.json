    {
      "id": "create-absolute",
      "description": "Create reminder at an explicit absolute time",
      "input": {
        "requestId": "create-absolute",
        "requestText": "Remind me to submit the quarterly report on November 16, 2026 at 5:00 PM.",
        "context": {
          "referenceNow": "2026-11-14T10:00:00+05:30",
          "timeZone": "Asia/Kolkata",
          "reminders": []
        }
      },
      "expectedPath": "model",
      "expectedDecision": "propose_action",
      "expectedIntent": "create",
      "expectedDueAt": "2026-11-16T17:00:00+05:30",
      "guardrailRequired": false,
      "semanticApplicable": true,
      "rubric": [
        {
          "id": "decision",
          "weight": 0.2,
          "op": "decision",
          "expected": "propose_action"
        },
        {
          "id": "intent",
          "weight": 0.15,
          "op": "intent",
          "expected": "create"
        },
        {
          "id": "title",
          "weight": 0.25,
          "op": "titleContains",
          "expected": [
            "quarterly",
            "report"
          ]
        },
        {
          "id": "due",
          "weight": 0.4,
          "op": "timestamp",
          "expected": "2026-11-16T17:00:00+05:30"
